{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static",
      "config": { "exclude": ["api/**", "server/**"] }
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Content-Type": "application/javascript; charset=utf-8",
        "Service-Worker-Allowed": "/"
      },
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.json",
      "headers": {
        "Content-Type": "application/manifest+json",
        "Cache-Control": "public, max-age=3600"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "/(.*\\.html)",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Pragma": "no-cache"
      }
    },
    {
      "src": "/(.*\\.js)",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/(.*\\.css)",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    { "src": "/download",        "dest": "/download.html" },
    { "src": "/home",            "dest": "/home.html" },
    { "src": "/courses",         "dest": "/courses.html" },
    { "src": "/login",           "dest": "/auth-login.html" },
    { "src": "/register",        "dest": "/auth-register.html" },
    { "src": "/dashboard",       "dest": "/dashboard.html" },
    { "src": "/course-detail",   "dest": "/course-detail.html" },
    { "src": "/course-payment",  "dest": "/course-payment.html" },
    { "src": "/payment",         "dest": "/payment.html" },
    { "src": "/payment-success", "dest": "/payment-success.html" },
    { "src": "/subscription",    "dest": "/subscription.html" },
    { "src": "/admin",           "dest": "/admin-dashboard.html" },
    { "src": "/instructor",      "dest": "/instructor-dashboard.html" },
    { "src": "/ai-assistant",    "dest": "/ai-assistant.html" },
    { "src": "/ai-study",        "dest": "/ai-study.html" },
    { "src": "/study-hub",       "dest": "/study-hub.html" },
    { "src": "/department-guide","dest": "/department-guide.html" },
    { "src": "/offline",         "dest": "/offline.html" },
    {
      "src": "/app/(.*)",
      "dest": "/dist/index.html"
    },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
