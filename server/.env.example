# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get free cluster at https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/alpha_tutorial

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_very_long_random_secret_key_here_min_32_chars
JWT_EXPIRE=30d

# ─── Client URL (your Vercel frontend URL) ────────────────────────────────────
CLIENT_URL=https://alpha-freshman-tutorial.vercel.app
SERVER_URL=https://your-backend.railway.app

# ─── Gmail SMTP ───────────────────────────────────────────────────────────────
# Enable 2FA on Gmail then create App Password at:
# https://myaccount.google.com/apppasswords
SMTP_USER=supportalphafreshman@gmail.com
SMTP_PASS=your_gmail_app_password_16_chars
EMAIL_FROM=supportalphafreshman@gmail.com

# ─── Owner Email (gets notified on payments & enrollments) ────────────────────
OWNER_EMAIL=supportalphafreshman@gmail.com

# ─── Chapa Payment (optional - leave empty for dev mode) ─────────────────────
CHAPA_SECRET_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
