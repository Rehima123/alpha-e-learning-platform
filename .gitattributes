# Force UTF-8 encoding for all text files — preserve emojis
* text=auto

# HTML, JS, CSS — keep LF line endings, UTF-8
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.svg  text eol=lf

# Binary files — don't touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
